# Rename this file to secrets.toml for local Streamlit development,
# OR paste these key-value pairs directly into the Streamlit Cloud Secrets UI.
# Never commit secrets.toml to source control.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional — only needed if your key is org-scoped rather than workspace-scoped.
# Anthropic will tell you clearly via a 400 error if you need this; find the ID
# at console.anthropic.com under your workspace's settings.
# ANTHROPIC_WORKSPACE_ID = "wrkspc_your-workspace-id-here"
